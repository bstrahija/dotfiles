[core]
	excludesfile = /Users/boris/.gitignore
	quotepath = false
	autocrlf = input
	editor = code -w
	safecrlf = false
	fileMode = false
	filemode = false
[user]
	name = Boris Strahija
	email = bstrahija@gmail.com
[color]
	ui = true
	status = auto
	diff = auto
	branch = auto
	interactive = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[status]
  submodule = 1
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[alias]
	st = status -sb
	stat = status
	ci = commit
	br = branch
	co = checkout
	cm = commit -m
	df = diff
	ds = diff --staged
	undo = reset --soft HEAD^
	standup = log --since '1 day ago' --oneline --author <boris@creolab.hr>
	graph = log --graph --pretty=format':%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset'
	lg = log --graph --pretty=format:'%Cred%h%Creset%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	ac = !git add -A && git commit -m
	acm = !git add -A && git commit -m
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	logx = log --all --graph --decorate --oneline --simplify-by-decoration
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	ls = log --pretty=format:\"%C(yellow)%h %C(blue)%ad%C(red)%d %C(reset)%s%C(green) [%cn]\" --decorate --date=short
	g = "!git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative"
	nah = "!f(){ git reset --hard; git clean -df; if [ -d ".git/rebase-apply" ] || [ -d ".git/rebase-merge" ]; then git rebase --abort; fi; }; f"
[format]
	pretty = "format:%Cred%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset"
[mergetool]
	keepBackup = true
	prompt = false
[push]
	default = current
[http]
	sslVerify = false
[credential]
	helper = osxkeychain
[merge]
	tool = opendiff
[diff]
	tool = opendiff
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[apply]
  whitespace = nowarn
[help]
	autocorrect = 1
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = false
[init]
	defaultBranch = main
