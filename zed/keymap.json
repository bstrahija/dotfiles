[
    {
        "context": "Workspace",
        "bindings": {
            "shift shift": "file_finder::Toggle",
            "cmd-e": "project_panel::ToggleFocus",
            "cmd-t": "terminal_panel::ToggleFocus",
            "cmd-i": "agent::ToggleFocus",
            "cmd-l": "agent::ToggleFocus",
            "ctrl-enter": "assistant::InlineAssist",
            "alt-cmd-p": "projects::OpenRecent",
            "cmd-g": "git_panel::ToggleFocus",
            "cmd-B": "multi_workspace::ToggleWorkspaceSidebar",
        },
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            "j j": "vim::NormalBefore",
            "j k": "vim::NormalBefore",
        },
    },

    // Buffers / tabs
    {
        "context": "Workspace",
        "bindings": {
            "cmd-1": ["pane::ActivateItem", 0],
            "cmd-2": ["pane::ActivateItem", 1],
            "cmd-3": ["pane::ActivateItem", 2],
            "cmd-4": ["pane::ActivateItem", 3],
            "cmd-5": ["pane::ActivateItem", 4],
            "cmd-6": ["pane::ActivateItem", 5],
            "cmd-7": ["pane::ActivateItem", 6],
            "cmd-8": ["pane::ActivateItem", 7],
            "cmd-9": ["pane::ActivateItem", 8],
        },
    },

    // Editor / leader
    {
        "context": "EmptyPane || SharedScreen || vim_operator == none && !VimWaiting && vim_mode != insert",
        "bindings": {
            "space space": "file_finder::Toggle",
            "space f f": "file_finder::Toggle",
            "space f s": "project_symbols::Toggle",
            "space f t": "text_finder::Toggle",
            "space f p": "projects::OpenRecent",
            "space w": "workspace::Save",
            "space t w": "editor::ToggleSoftWrap",

            // Multicursor
            "cmd-alt-j": ["editor::AddSelectionBelow", { "skip_soft_wrap": true }],
            "cmd-alt-k": ["editor::AddSelectionAbove", { "skip_soft_wrap": true }],

            // Navigate tabs / alternate file
            "space a": "pane::AlternateFile",
            "space b b": "pane::AlternateFile",
            "space b n": "pane::ActivateNextItem",
            "space b p": "pane::ActivatePreviousItem",
            "space t t": "tab_switcher::Toggle",
            "space t g": "editor::ToggleTabBar",
            "space t p": "pane::TogglePinTab",

            // Copy/yank/paste
            "Y": ["workspace::SendKeystrokes", "y $"],
            "space p": ["workspace::SendKeystrokes", "\" 0 p"],
            "space P": ["workspace::SendKeystrokes", "\" 0 P"],

            // Surround
            "space '": ["workspace::SendKeystrokes", "y s i w '"],
            "space `": ["workspace::SendKeystrokes", "y s i w `"],
            "space \"": ["workspace::SendKeystrokes", "y s i w \""],
            "space <": ["workspace::SendKeystrokes", "y s i w <"],
            "space >": ["workspace::SendKeystrokes", "y s i w >"],
            "space {": ["workspace::SendKeystrokes", "y s i w {"],
            "space }": ["workspace::SendKeystrokes", "y s i w }"],
            "space [": ["workspace::SendKeystrokes", "y s i w ["],
            "space ]": ["workspace::SendKeystrokes", "y s i w ]"],
            "space (": ["workspace::SendKeystrokes", "y s i w ("],
            "space )": ["workspace::SendKeystrokes", "y s i w )"],

            // Splits
            "ctrl-w \\": "pane::SplitAndMoveRight",
            "ctrl-w -": "pane::SplitAndMoveDown",
            "ctrl-w j": "pane::JoinAll",
            "ctrl-w h": "pane::SplitDown",
            "ctrl-w v": "pane::SplitRight",

            // Zoom / Zen
            "space z": "workspace::ToggleZoom",

            // Folding
            "ctrl-f f": "editor::ToggleFold",
            "ctrl-f ctrl-f": "editor::ToggleFold",
            "ctrl-f F": "editor::ToggleFoldAll",
            "ctrl-f a": "editor::FoldAll",
            "ctrl-f ctrl-a": "editor::FoldAll",
            "ctrl-f ctrl-u": "editor::UnfoldAll",

            // Comments
            "space c": "editor::ToggleComments",

            // Closing
            "space q q": "pane::CloseActiveItem",
            "space x": "pane::CloseActiveItem",
            "space q o": "pane::CloseOtherItems",
            "space q a": "pane::CloseAllItems",
            "space Q": "workspace::CloseWindow",

            // Git
            "space g g": "git_panel::ToggleFocus",
            "space g B": "git::Blame",
            "space g b": "editor::ToggleGitBlameInline",
            "space g h": "git::FileHistory",
            "space g l": ["task::Spawn", { "task_name": "lazygit" }],
            "space g n": "editor::GoToHunk",

            // Errors / diagnostics
            "space e e": "diagnostics::Deploy",
            "space e n": "editor::GoToDiagnostic",
            "space e ]": "editor::GoToDiagnostic",
            "space e p": "editor::GoToPreviousDiagnostic",
            "space e [": "editor::GoToPreviousDiagnostic",
            "space e t": "editor::ToggleInlineDiagnostics",

            // Code
            "g o": "outline_panel::ToggleFocus",
            "g i": "editor::GoToImplementation",
            "g I": "editor::GoToImplementationSplit",
            "g D": "editor::GoToDefinitionSplit",
            "g r": "editor::GoToNextReference",
            "g R": "editor::Rename",
            "space r": "editor::Rename",
            "g =": "editor::Format",
            "space =": "editor::Format",
            "g m": "vim::Matching",
            "g l": "editor::OpenSelectedFilename",

            // Settings
            "space s s": "zed::OpenSettingsFile",
            "space s k": "zed::OpenKeymapFile",
            "space s t": "theme_selector::Toggle",
            "space s i": "icon_theme_selector::Toggle",
            "space s x": "zed::OpenTasks",
        },
    },

    {
        "context": "Editor",
        "bindings": {
            "ctrl-n": ["editor::SelectNext", { "replace_newest": false }],
            "ctrl-/": "vim::ToggleComments",
            "alt-j": "editor::MoveLineDown",
            "alt-k": "editor::MoveLineUp",
            "ctrl-]": "pane::ActivateNextItem",
            "ctrl-[": "pane::ActivatePreviousItem",
            "alt-t": "vim::Increment",
            "cmd-ctrl-[": "editor::SelectLargerSyntaxNode",
            "cmd-ctrl-]": "editor::SelectSmallerSyntaxNode",
        },
    },

    // Manage files in project panel ()
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "a": "project_panel::NewFile",
            "A": "project_panel::NewDirectory",
            "p": "project_panel::Paste",
            "x": "project_panel::Cut",
            "s": "project_panel::Open",
            "c": "project_panel::Copy",
            "r": "project_panel::Rename",
            "d": "project_panel::Trash",
            "l": "project_panel::Open",
            "shift-d": "project_panel::Delete",
        },
    },

    // Marks
    {
        "context": "Editor && VimControl && !VimWaiting && !menu",
        "bindings": {
            "space 1": ["workspace::SendKeystrokes", "' 1"],
            "space 2": ["workspace::SendKeystrokes", "' 2"],
            "space 3": ["workspace::SendKeystrokes", "' 3"],
            "space 4": ["workspace::SendKeystrokes", "' 4"],
            "space 5": ["workspace::SendKeystrokes", "' 5"],
            "space 6": ["workspace::SendKeystrokes", "' 6"],
            "space 7": ["workspace::SendKeystrokes", "' 7"],
            "space 8": ["workspace::SendKeystrokes", "' 8"],
            "space 9": ["workspace::SendKeystrokes", "' 9"],
            "space m m": ["workspace::SendKeystrokes", ": marks enter"],
        },
    },

    // Vim sneak
    {
        "context": "Editor && vim_mode == normal",
        "bindings": {
            "alt-h": "vim::StartOfLineDownward",
            "alt-l": "vim::EndOfLineDownward",
            "s": "vim::PushSneak",
            "S": "vim::PushSneakBackward",
            "space y": ["workspace::SendKeystrokes", "\" + y"],
            "space shift-y": ["workspace::SendKeystrokes", "\" + shift-y"],
            "space d": ["workspace::SendKeystrokes", "\" _ d"],
        },
    },

    // AI / Agents
    {
        "context": "Editor && edit_prediction && edit_prediction_mode == eager && !showing_completions",
        "bindings": {
            "ctrl-y": "editor::AcceptEditPrediction",
        },
    },

    // Markdown
    {
        "context": "Editor && (vim_mode == normal || vim_mode == visual) && vim_operator == none && !VimWaiting",
        "bindings": {
            "space m p": "markdown::OpenPreview",
            "space m P": "markdown::OpenPreviewToTheSide",
        },
    },
    {
        "context": "Markdown",
        "bindings": {
            "j": "markdown::ScrollDown",
            "k": "markdown::ScrollUp",
            "ctrl-d": "editor::HalfPageDown",
            "ctrl-u": "editor::HalfPageUp",
        }
    },

    // Indenting, pasting, deleting, surrounnding
    {
        "context": "Editor && (vim_mode == visual || vim_mode == visual_line)",
        "bindings": {
            "tab": "editor::Indent",
            "shift-tab": "editor::Outdent",
            "space y": ["workspace::SendKeystrokes", "\" + y"],
            "space d": ["workspace::SendKeystrokes", "\" _ d"],

            // Keep selection when indenting
            ">": ["workspace::SendKeystrokes", "> g v"],
            "<": ["workspace::SendKeystrokes", "< g v"],

            // Surrounding in visual mode
            "shift-s": ["vim::PushAddSurrounds", {}],
            "space s '": ["workspace::SendKeystrokes", "S '"],
            "space s `": ["workspace::SendKeystrokes", "S `"],
            "space s \"": ["workspace::SendKeystrokes", "S \""],
            "space s <": ["workspace::SendKeystrokes", "S <"],
            "space s >": ["workspace::SendKeystrokes", "S >"],
            "space s {": ["workspace::SendKeystrokes", "S {"],
            "space s }": ["workspace::SendKeystrokes", "S }"],
            "space s [": ["workspace::SendKeystrokes", "S ["],
            "space s ]": ["workspace::SendKeystrokes", "S ]"],
            "space s (": ["workspace::SendKeystrokes", "S ("],
            "space s )": ["workspace::SendKeystrokes", "S )"],
        },
    },

    // AI
    // 1. Accept AI suggestion with Ctrl-Y (non-conflict context)
    {
        "context": "Editor && edit_prediction",
        "bindings": {
            "ctrl-y": "editor::AcceptEditPrediction",
        },
    },

    // 2. Accept AI suggestion with Ctrl-Y (conflict context - when LSP menu is also visible)
    {
        "context": "Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
        "bindings": {
            "ctrl-y": "editor::AcceptEditPrediction",
        },
    },

    // 3. Prevent TAB from accepting the suggestion (restores normal indent)
    // This must be a specific override to beat the default binding.
    {
        "context": "Editor && edit_prediction && vim_mode != visual",
        "bindings": {
            "tab": "editor::Tab",
        },
    },

    // 4. Prevent TAB from accepting the suggestion in the conflict context
    {
        "context": "Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
        "bindings": {
            "tab": "editor::Tab",
        },
    },
    {
        "context": "(Editor && !edit_prediction)",
        "bindings": {
            "alt-x": "editor::ShowEditPrediction",
        },
    },
    {
        "context": "((Editor && mode == full) && edit_prediction)",
        "bindings": {
            "alt-x": "editor::NextEditPrediction",
        },
    },

    // Unbind overriden stuff
    {
        "context": "Editor && edit_prediction && edit_prediction_mode == eager && !showing_completions",
        "unbind": {
            "tab": "editor::AcceptEditPrediction",
        },
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-?": "agent::ToggleFocus",
        },
    },
    {
        "context": "Editor && mode == full",
        "unbind": {
            "cmd-e": "buffer_search::UseSelectionForFind",
        },
    },
    {
        "context": "KeymapEditor",
        "unbind": {
            "cmd-e": "zed::OpenKeymapFile",
        },
    },
    {
        "context": "Editor",
        "unbind": {
            "cmd-i": "editor::ShowSignatureHelp",
        },
    },
    {
        "context": "DebugPanel",
        "unbind": {
            "cmd-i": "debugger::ToggleSessionPicker",
        },
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-shift-b": "outline_panel::ToggleFocus",
        },
    },
    {
        "context": "Workspace",
        "unbind": {
            "alt-cmd-j": "multi_workspace::ToggleWorkspaceSidebar",
        },
    },
    {
        "context": "VimControl && !menu",
        "unbind": {
            "ctrl-f": "vim::PageDown",
        },
    },
    {
        "context": "Editor",
        "unbind": {
            "ctrl-f": "editor::MoveRight",
        },
    },
    {
        "context": "vim_mode == literal",
        "unbind": {
            "ctrl-f": ["vim::Literal", ["ctrl-f", "\u0006"]],
        },
    },
    {
        "context": "Editor",
        "unbind": {
            "cmd-l": "editor::SelectLine",
        },
    },
    {
        "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
        "unbind": {
            "cmd-l": "pane::SplitRight",
        },
    },
    {
        "context": "TextFinder || TextFinder > Picker > Editor || TextFinder > Picker > menu",
        "unbind": {
            "cmd-l": "pane::SplitRight",
        },
    },
    {
        "context": "Pane",
        "unbind": {
            "cmd-g": "search::SelectNextMatch",
        },
    },
]
