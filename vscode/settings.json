    "vim.normalModeKeyBindingsNonRecursive": [
        // Scroll up/down and
        { "before": ["<C-d>"], "after": ["<C-d>", "z", "z"] },
        { "before": ["<C-u>"], "after": ["<C-u>", "z", "z"] },

        // Disable arrow keyy in normal to practice hj
        { "before": ["<up>"], "commands": [":echo 'Use k instead of ↑'"] },
        { "before": ["<down>"], "commands": [":echo 'Use j instead of ↓'"] },
        { "before": ["<left>"], "commands": [":echo 'Use h instead of ←'"] },
        { "before": ["<right>"], "commands": [":echo 'Use l instead of →'"] },

        // Harpoon
        { "before": ["leader", "m", "a"], "commands": ["vscode-harpoon.addEditor"] },
        { "before": ["leader", "m", "1"], "commands": ["vscode-harpoon.addEditor1"] },
        { "before": ["leader", "m", "2"], "commands": ["vscode-harpoon.addEditor2"] },
