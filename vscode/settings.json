{
    // Theme
    "workbench.colorTheme": "Catppuccin Macchiato",
    "workbench.iconTheme": "charmed-soft",

    // Font
    "editor.fontFamily": "MonaspiceKr Nerd Font",
    "workbench.fontAliasing": "auto",
    "window.zoomLevel": 0.5,
    "editor.fontSize": 12.5,
    "editor.fontWeight": "400",
    "editor.lineHeight": 3,
    "fontshortcuts.defaultFontSize": 14,
    "fontshortcuts.defaultTerminalFontSize": 14,
    "fontshortcuts.step": 1,

    // Misc UI
    "editor.cursorBlinking": "solid",
    "editor.smoothScrolling": false,
    "workbench.list.smoothScrolling": false,
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "editor.minimap.enabled": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.rulers": [320],
    "workbench.editor.editorActionsLocation": "hidden",
    "editor.inlayHints.enabled": "off",
    "breadcrumbs.enabled": false,
    "workbench.editor.tabSizing": "fit",
    "catppuccin-icons.hidesExplorerArrows": true,
    "chat.commandCenter.enabled": false,
    "workbench.layoutControl.enabled": false,
    "editor.matchBrackets": "near",
    "editor.lightbulb.enabled": "off",
    "editor.renderLineHighlight": "all",
    "editor.occurrencesHighlight": "off",
    "editor.selectionHighlight": true,
    "editor.hideCursorInOverviewRuler": true,
    "workbench.editor.enablePreview": false,
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.vertical": "auto",
    "editor.scrollbar.horizontalScrollbarSize": 12,
    "editor.scrollbar.verticalScrollbarSize": 12,
    "editor.autoClosingBrackets": "beforeWhitespace",
    "editor.autoClosingQuotes": "beforeWhitespace",
    "git.blame.statusBarItem.enabled": false,
    "workbench.navigationControl.enabled": false,
    "window.commandCenter": false,
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editor.navigationScope": "editorGroup",
    "workbench.tree.renderIndentGuides": "onHover",
    "editor.guides.indentation": true,

    // Autosuggestions for editor
    // "editor.suggestOnTriggerCharacters": true,
    // "editor.quickSuggestions": {
    //     "other": "off",
    //     "comments": "off",
    //     "strings": "off"
    // },
    "editor.tabCompletion": "on",
    "editor.snippetSuggestions": "inline",
    "emmet.triggerExpansionOnTab": true,

    // Project pane (file explorer)
    "explorer.compactFolders": false,
    "workbench.tree.indent": 18,
    "files.exclude": {
        "**/.idea": true,
        "**/_ide_helper*": true,
        "**/_ide_helper_models*": true,
        "**/.phpstorm.meta.php": true,
    },

    // Search
    "search.mode": "reuseEditor",
    "search.exclude": {
        "**/.git": true,
        "**/*.log": true,
        "**/node_modules": true,
        "**/tmp": true,
        "**/wp-content/**/public": true,
    },

    // AI
    "github.copilot.nextEditSuggestions.enabled": true,
    "editor.inlineSuggest.enabled": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,

    // LSP's
    "editor.codeLens": false,
    "editor.formatOnSave": false,

    // Git/SCM
    "git.blame.editorDecoration.enabled": false,
    "git.decorations.enabled": true,
    "scm.diffDecorations": "gutter",

    // ==> PHP
    "php.version": "v8.4",
    "intelephense.environment.phpVersion": "8.4.0",
    "php.executables": {
        "v7.4": "/Users/boris/Library/Application Support/Herd/bin/php74",
        "v8.0": "/Users/boris/Library/Application Support/Herd/bin/php80",
        "v8.1": "/Users/boris/Library/Application Support/Herd/bin/php81",
        "v8.2": "/Users/boris/Library/Application Support/Herd/bin/php82",
        "v8.3": "/Users/boris/Library/Application Support/Herd/bin/php83",
        "v8.4": "/Users/boris/Library/Application Support/Herd/bin/php84",
        "v8.5": "/Users/boris/Library/Application Support/Herd/bin/php85",
    },
    "laravel-pint.enable": true,
    "intelephense.files.associations": ["*.blade.php", "*.php", "*.phtml"],
    "intelephense.files.exclude": ["**/_ide_helper*", "**/_ide_helper_models*", "**/.phpstorm.meta.php"],
    "php.completion.showParameters": true,
    "php.problems.excludeGitIgnore": true,
    "Laravel.phpEnvironment": "herd",
    "[php]": {
        "editor.defaultFormatter": "open-southeners.laravel-pint",
        "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\"-,.<>/?",
    },
    "[blade]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    },
    "php.suggest.basic": false,
    "php.validate.enable": false,
    "php.problems.exclude": {
        "**/*": [
            "PHP6602",
            "PHP6613"
        ]
    },

    // ==> Other LSP's
    "json.format.enable": false,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar",
    },
    "[lua]": {
        "editor.defaultFormatter": "sumneko.lua",
    },
    "files.associations": {
        "*.embeddedhtml": "html",
        ".env*": "dotenv",
    },
    "Lua.diagnostics.globals": ["vim"],
    "prettier.printWidth": 400,
    "prettier.tabWidth": 4,

    // Other
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 0,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.linkedEditing": true,
    "editor.semanticTokenColorCustomizations": {},
    "todo-tree.ripgrep": "/opt/homebrew/bin/rg",

    // Spell Check
    "cSpell.blockCheckingWhenLineLengthGreaterThan": 100000,
    "cSpell.diagnosticLevel": "Hint",
    "cSpell.customDictionaries": {
        "custom-dictionary-user": {
            "name": "My Dictionary",
            "path": "~/.config/cspell/dictionary.txt",
            "addWords": true,
            "scope": "user",
        },
    },
    "cSpell.enabledNotifications": {
        "Average Word Length too Long": false,
        "Lines too Long": false,
        "Maximum Word Length Exceeded": false,
    },

    // Vim
    "editor.lineNumbers": "relative",
    "vim.leader": "<space>",
    "vim.incsearch": true,
    "vim.hlsearch": true,
    "vim.useSystemClipboard": true,
    "vim.highlightedyank.enable": true,
    "vim.surround": true,
    "vim.sneak": true,
    "vim.sneakUseIgnorecaseAndSmartcase": true,
    "vim.camelCaseMotion.enable": true,
    "extensions.experimental.affinity": {
        // Vim - make if more performant
        "vscode.vim": 1,
        "asvetliakov.vscode-neovim": 1,
    },
    "vscode-textobjects.vimEnabled": true,
    "vim.targets.enable": true,

    // Vim keybindings

    // ==> Normal mode
    "vim.normalModeKeyBindings": [
        // Remove search highlight on escape
        { "before": ["<Esc>"], "after": ["<Esc>"], "commands": [":nohl"], "silent": true },

        // Nicer redo
        { "before": ["U"], "after": ["<C-r>"] },

        // Markdown preview
        { "before": ["leader", "m", "p"], "commands": ["markdown.showPreviewToSide"] },
        { "before": ["leader", "m", "P"], "commands": ["markdown.showPreview"] },

        // Navigate tabs
        { "before": ["g", "t"], "commands": ["workbench.action.nextEditor"] },
        { "before": ["leader", "1"], "commands": ["workbench.action.openEditorAtIndex1"] },
        { "before": ["leader", "2"], "commands": ["workbench.action.openEditorAtIndex2"] },
        { "before": ["leader", "3"], "commands": ["workbench.action.openEditorAtIndex3"] },
        { "before": ["leader", "4"], "commands": ["workbench.action.openEditorAtIndex4"] },
        { "before": ["leader", "5"], "commands": ["workbench.action.openEditorAtIndex5"] },
        { "before": ["leader", "6"], "commands": ["workbench.action.openEditorAtIndex6"] },
        { "before": ["leader", "7"], "commands": ["workbench.action.openEditorAtIndex7"] },
        { "before": ["leader", "8"], "commands": ["workbench.action.openEditorAtIndex8"] },
        { "before": ["leader", "9"], "commands": ["workbench.action.openEditorAtIndex9"] },

        // Alternate between last two files
        { "before": ["<C-^>"], "commands": ["workbench.action.openPreviousEditor"] },

        // AI
        { "before": ["leader", "x"], "commands": ["workbench.panel.chat.view.copilot.focus"] },

        // Splits
        { "before": ["leader", "\\"], "commands": ["workbench.action.splitEditor"] },
        { "before": ["ctrl+w", "s"], "commands": ["workbench.action.splitEditor"] },
        { "before": ["leader", "-"], "commands": ["workbench.action.splitEditorDown"] },
        { "before": ["ctrl+w", "v"], "commands": ["workbench.action.splitEditorDown"] },

        // Toggle comments in normal and visual mode
        { "before": ["leader", "c"], "commands": ["editor.action.commentLine"] },

        // Code navigation and actions
        { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
        { "before": ["g", "shift+d"], "commands": ["editor.action.revealDefinitionAside"] },
        { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
        { "before": ["g", "h"], "commands": ["editor.action.showHover"] },
        { "before": ["shift+k"], "commands": ["editor.action.showHover"] },
        { "before": ["g", "shift+t"], "commands": ["editor.action.goToTypeDefinition"] },
        { "before": ["g", "r"], "commands": ["editor.action.referenceSearch.trigger"] },
        { "before": ["g", "a"], "commands": ["editor.action.quickFix"] },
        { "before": ["g", "shift+r"], "commands": ["editor.action.rename"] },
        { "before": ["g", "s"], "commands": ["tettekete.list-functions"] },
        { "before": ["g", "o"], "commands": ["workbench.action.gotoSymbol"] },
        { "before": ["g", "l"], "commands": ["editor.action.openLink"] },

        // Errors and warnings
        { "before": ["g", "e", "["], "commands": ["editor.action.marker.prevInFiles"] },
        { "before": ["g", "e", "]"], "commands": ["editor.action.marker.nextInFiles"] },
        { "before": ["g", "["], "commands": ["editor.action.marker.prev"] },
        { "before": ["g", "]"], "commands": ["editor.action.marker.next"] },
        { "before": ["leader", "e", "a"], "commands": ["workbench.action.problems.focus"] },
        { "before": ["leader", "e", "e"], "commands": ["workbench.action.problems.focus"] },

        // Zen mode
        { "before": ["leader", "z"], "commands": ["workbench.action.toggleZenMode"] },

        // Files, tabs, search
        { "before": ["leader", "space"], "commands": ["workbench.action.quickOpen"] },
        { "before": ["leader", "f"], "commands": ["editor.action.formatDocument"] },
        { "before": ["leader", "tab"], "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"] },
        { "before": ["leader", "w"], "commands": ["workbench.action.files.save"] },
        { "before": ["leader", "q", "q"], "commands": ["workbench.action.closeActiveEditor"] },
        { "before": ["ctrl+w", "q"], "commands": ["workbench.action.closeActiveEditor"] },
        { "before": ["leader", "q", "o"], "commands": ["workbench.action.closeOtherEditors"] },
        { "before": ["ctrl+w", "o"], "commands": ["workbench.action.closeOtherEditors"] },
        { "before": ["<C-w>"], "commands": ["workbench.action.closeActiveEditor"] },
        { "before": ["leader", "Q"], "commands": ["workbench.action.closeWindow"] },
        { "before": ["leader", ","], "commands": ["workbench.action.showAllEditors"] },
        { "before": ["leader", "/"], "commands": ["workbench.action.findInFiles"] },
        { "before": ["leader", "="], "commands": ["editor.action.formatDocument"] },
        { "before": ["leader", "t"], "commands": ["terminal.focus"] },

        // Git
        { "before": ["leader", "g", "l"], "commands": ["workbench.action.tasks.runTask"], "args": ["Run lazygit"] },
        { "before": ["leader", "g", "g"], "commands": ["workbench.view.scm"] },

        // Folding code
        { "before": ["leader", "f"], "commands": ["editor.toggleFold"] },
        { "before": ["leader", "F", "F"], "commands": ["editor.foldAll"] },
        { "before": ["leader", "F", "U"], "commands": ["editor.unfoldAll"] },

        // Projects
        { "before": ["leader", "p", "p"], "commands": ["projectManager.listProjects"] },

        // Open JSON settings and keyboard shortcuts, and themes and icons
        { "before": ["leader", "s", "s"], "commands": ["workbench.action.openSettingsJson"] },
        { "before": ["leader", "s", "k"], "commands": ["workbench.action.openGlobalKeybindingsFile"] },
        { "before": ["leader", "s", "t"], "commands": ["workbench.action.selectTheme"] },
        { "before": ["leader", "s", "i"], "commands": ["workbench.action.selectIconTheme"] },

        // Jumplist (a bit different, but the vim extension doesn't remember when navigating symbols)
        { "before": ["leader", "j", "j"], "commands": [":jumps"] },
        { "before": ["leader", "j", "c"], "commands": [":clearjumps"] },

        // Move to line start/end
        { "before": ["L"], "after": ["$"] },
        { "before": ["H"], "after": ["^"] },

        // Copying
        { "before": ["Y"], "after": ["y", "$"] },
        { "before": ["g", "y"], "after": ["m", "y", "g", "g", "V", "G", "y", "`", "y", "z", "z"] }, // Select entire file and yank

        // Delete without affecting the clipboard
        { "before": ["x"], "commands": ["deleteRight"] },
        { "before": ["X"], "commands": ["deleteLeft"] },

        // Numbers
        { "before": ["+"], "commands": ["editor.emmet.action.incrementNumberByOne"] },
        { "before": ["-"], "commands": ["editor.emmet.action.decrementNumberByOne"] },

        // Indenting lines
        { "before": [">"], "commands": ["editor.action.indentLines"] },
        { "before": ["<"], "commands": ["editor.action.outdentLines"] },

        // Projects
        { "before": ["leader", "p", "o"], "commands": ["projectManager.listProjects"], "args": { "projectName": "optimizepress", "openInNewWindow": false } },
        { "before": ["leader", "p", "z"], "commands": ["projectManager.listProjects"], "args": { "projectName": "zimsko", "openInNewWindow": false } },
        { "before": ["leader", "p", "k"], "commands": ["projectManager.listProjects"], "args": { "projectName": "kourses", "openInNewWindow": false } },
        { "before": ["leader", "p", "h"], "commands": ["projectManager.listProjects"], "args": { "projectName": "optimizepress-hub", "openInNewWindow": false } },

        // Text object motions
        // ===> Selection
        { "before": ["v", "a", "f"], "commands": ["vscode-textobjects.select.next.outer.function.start"] },
        { "before": ["v", "i", "f"], "commands": ["vscode-textobjects.select.next.inner.function.start"] },
        { "before": ["v", "a", "l"], "commands": ["vscode-textobjects.select.next.outer.loop.start"] },
        { "before": ["v", "i", "l"], "commands": ["vscode-textobjects.select.next.inner.loop.start"] },
        { "before": ["v", "a", "i"], "commands": ["vscode-textobjects.select.next.outer.conditional.start"] },
        { "before": ["v", "i", "i"], "commands": ["vscode-textobjects.select.next.inner.conditional.start"] },
        { "before": ["v", "a", "r"], "commands": ["vscode-textobjects.select.next.outer.rhs.start"] },
        { "before": ["v", "i", "r"], "commands": ["vscode-textobjects.select.next.inner.rhs.start"] },
        { "before": ["v", "a", "h"], "commands": ["vscode-textobjects.select.next.outer.lhs.start"] },
        { "before": ["v", "i", "h"], "commands": ["vscode-textobjects.select.next.inner.lhs.start"] },
        { "before": ["v", "a", "v"], "commands": ["vscode-textobjects.select.next.outer.variable.start"] },
        { "before": ["v", "a", "q"], "commands": ["vscode-textobjects.select.next.outer.string.start"] },
        { "before": ["v", "i", "q"], "commands": ["vscode-textobjects.select.next.inner.string.start"] },
        { "before": ["v", "a", "k"], "commands": ["vscode-textobjects.select.next.outer.class.start"] },
        { "before": ["v", "i", "k"], "commands": ["vscode-textobjects.select.next.inner.class.start"] },
        { "before": ["v", "a", "a"], "commands": ["vscode-textobjects.select.next.outer.array.start"] },
        { "before": ["v", "i", "a"], "commands": ["vscode-textobjects.select.next.inner.array.start"] },
        { "before": ["v", "a", "o"], "commands": ["vscode-textobjects.select.next.outer.object.start"] },
        { "before": ["v", "i", "o"], "commands": ["vscode-textobjects.select.next.inner.object.start"] },
        { "before": ["v", "a", "e"], "commands": ["vscode-textobjects.select.next.outer.parameters.start"] },
        { "before": ["v", "i", "e"], "commands": ["vscode-textobjects.select.next.inner.parameters.start"] },
        { "before": ["v", "a", "m"], "commands": ["vscode-textobjects.select.next.outer.call.start"] },
        { "before": ["v", "i", "m"], "commands": ["vscode-textobjects.select.next.inner.call.start"] },
        { "before": ["v", "a", "c"], "commands": ["vscode-textobjects.select.next.outer.comment.start"] },
        { "before": ["v", "i", "c"], "commands": ["vscode-textobjects.select.next.inner.comment.start"] },

        // ==> Moving
        { "before": ["[", "f"], "commands": ["vscode-textobjects.goTo.next.outer.function.start"] },
        { "before": ["[", "F"], "commands": ["vscode-textobjects.goTo.next.inner.function.start"] },
        { "before": ["[", "q"], "commands": ["vscode-textobjects.goTo.next.outer.string.start"] },
        { "before": ["[", "Q"], "commands": ["vscode-textobjects.goTo.next.inner.string.start"] },
        { "before": ["]", "f"], "commands": ["vscode-textobjects.goTo.previous.outer.function.start"] },
        { "before": ["]", "F"], "commands": ["vscode-textobjects.goTo.previous.inner.function.start"] },
        { "before": ["]", "q"], "commands": ["vscode-textobjects.goTo.previous.outer.string.start"] },
        { "before": ["]", "Q"], "commands": ["vscode-textobjects.goTo.previous.inner.string.start"] },

        // ==> Deleting
        { "before": ["d", "a", "f"], "commands": ["vscode-textobjects.delete.next.outer.function.start"] },
        { "before": ["d", "i", "f"], "commands": ["vscode-textobjects.delete.next.inner.function.start"] },
        { "before": ["d", "a", "l"], "commands": ["vscode-textobjects.delete.next.outer.loop.start"] },
        { "before": ["d", "i", "l"], "commands": ["vscode-textobjects.delete.next.inner.loop.start"] },
        { "before": ["d", "a", "i"], "commands": ["vscode-textobjects.delete.next.outer.conditional.start"] },
        { "before": ["d", "i", "i"], "commands": ["vscode-textobjects.delete.next.inner.conditional.start"] },
        { "before": ["d", "a", "r"], "commands": ["vscode-textobjects.delete.next.outer.rhs.start"] },
        { "before": ["d", "i", "r"], "commands": ["vscode-textobjects.delete.next.inner.rhs.start"] },
        { "before": ["d", "a", "h"], "commands": ["vscode-textobjects.delete.next.outer.lhs.start"] },
        { "before": ["d", "i", "h"], "commands": ["vscode-textobjects.delete.next.inner.lhs.start"] },
        { "before": ["d", "a", "v"], "commands": ["vscode-textobjects.delete.next.outer.variable.start"] },
        { "before": ["d", "a", "q"], "commands": ["vscode-textobjects.delete.next.outer.string.start"] },
        { "before": ["d", "i", "q"], "commands": ["vscode-textobjects.delete.next.inner.string.start"] },
        { "before": ["d", "a", "k"], "commands": ["vscode-textobjects.delete.next.outer.class.start"] },
        { "before": ["d", "i", "k"], "commands": ["vscode-textobjects.delete.next.inner.class.start"] },
        { "before": ["d", "a", "a"], "commands": ["vscode-textobjects.delete.next.outer.array.start"] },
        { "before": ["d", "i", "a"], "commands": ["vscode-textobjects.delete.next.inner.array.start"] },
        { "before": ["d", "a", "o"], "commands": ["vscode-textobjects.delete.next.outer.object.start"] },
        { "before": ["d", "i", "o"], "commands": ["vscode-textobjects.delete.next.inner.object.start"] },
        { "before": ["d", "a", "e"], "commands": ["vscode-textobjects.delete.next.outer.parameters.start"] },
        { "before": ["d", "i", "e"], "commands": ["vscode-textobjects.delete.next.inner.parameters.start"] },
        { "before": ["d", "a", "m"], "commands": ["vscode-textobjects.delete.next.outer.call.start"] },
        { "before": ["d", "i", "m"], "commands": ["vscode-textobjects.delete.next.inner.call.start"] },
        { "before": ["d", "a", "c"], "commands": ["vscode-textobjects.delete.next.outer.comment.start"] },
        { "before": ["d", "i", "c"], "commands": ["vscode-textobjects.delete.next.inner.comment.start"] },
        { "before": ["d", "a", "n"], "commands": ["vscode-textobjects.delete.next.outer.node.start"] },

        // ==> Yanking (copying)
        { "before": ["y", "a", "f"], "commands": ["vscode-textobjects.yank.next.outer.function.start"] },
        { "before": ["y", "i", "f"], "commands": ["vscode-textobjects.yank.next.inner.function.start"] },
        { "before": ["y", "a", "l"], "commands": ["vscode-textobjects.yank.next.outer.loop.start"] },
        { "before": ["y", "i", "l"], "commands": ["vscode-textobjects.yank.next.inner.loop.start"] },
        { "before": ["y", "a", "i"], "commands": ["vscode-textobjects.yank.next.outer.conditional.start"] },
        { "before": ["y", "i", "i"], "commands": ["vscode-textobjects.yank.next.inner.conditional.start"] },
        { "before": ["y", "a", "r"], "commands": ["vscode-textobjects.yank.next.outer.rhs.start"] },
        { "before": ["y", "i", "r"], "commands": ["vscode-textobjects.yank.next.inner.rhs.start"] },
        { "before": ["y", "a", "h"], "commands": ["vscode-textobjects.yank.next.outer.lhs.start"] },
        { "before": ["y", "i", "h"], "commands": ["vscode-textobjects.yank.next.inner.lhs.start"] },
        { "before": ["y", "a", "v"], "commands": ["vscode-textobjects.yank.next.outer.variable.start"] },
        { "before": ["y", "a", "q"], "commands": ["vscode-textobjects.yank.next.outer.string.start"] },
        { "before": ["y", "i", "q"], "commands": ["vscode-textobjects.yank.next.inner.string.start"] },
        { "before": ["y", "a", "k"], "commands": ["vscode-textobjects.yank.next.outer.class.start"] },
        { "before": ["y", "i", "k"], "commands": ["vscode-textobjects.yank.next.inner.class.start"] },
        { "before": ["y", "a", "a"], "commands": ["vscode-textobjects.yank.next.outer.array.start"] },
        { "before": ["y", "i", "a"], "commands": ["vscode-textobjects.yank.next.inner.array.start"] },
        { "before": ["y", "a", "o"], "commands": ["vscode-textobjects.yank.next.outer.object.start"] },
        { "before": ["y", "i", "o"], "commands": ["vscode-textobjects.yank.next.inner.object.start"] },
        { "before": ["y", "a", "e"], "commands": ["vscode-textobjects.yank.next.outer.parameters.start"] },
        { "before": ["y", "i", "e"], "commands": ["vscode-textobjects.yank.next.inner.parameters.start"] },
