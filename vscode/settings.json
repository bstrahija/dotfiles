        { "before": ["leader", "m", "5"], "commands": ["vscode-harpoon.addEditor5"] },
        { "before": ["leader", "m", "m"], "commands": ["vscode-harpoon.editorQuickPick"] },
        { "before": ["leader", "m", "e"], "commands": ["vscode-harpoon.editEditors"] },
        { "before": ["leader", "1"], "commands": ["vscode-harpoon.gotoEditor1"] },
        { "before": ["leader", "2"], "commands": ["vscode-harpoon.gotoEditor2"] },
        { "before": ["leader", "3"], "commands": ["vscode-harpoon.gotoEditor3"] },
        { "before": ["leader", "4"], "commands": ["vscode-harpoon.gotoEditor4"] },
        { "before": ["leader", "5"], "commands": ["vscode-harpoon.gotoEditor5"] },

        // Marks
        { "before": ["'", "a"], "after": ["`", "a"] },
        { "before": ["'", "s"], "after": ["`", "s"] },
        { "before": ["leader", "m", "M"], "commands": [":marks"] },
        { "before": ["leader", "m", "c"], "commands": [":delmarks a-zA-Z0-9"] },
    ],

    // ==> Insert mode
    "vim.insertModeKeyBindings": [
        // Back to normal mode
        { "before": ["j", "j"], "after": ["<Esc>"] },
        { "before": ["j", "k"], "after": ["<Esc>"] },
        { "before": ["k", "j"], "after": ["<Esc>"] },

        // Easy insert of trailing ; and ,
        { "before": [";", ";"], "after": ["<Esc>", "A", ";"] },
        { "before": [",", ","], "after": ["<Esc>", "A", ","] },

        // Undo breakpoints
        { "before": ["."], "after": [".", "<C-g>", "u"] },
        { "before": [","], "after": [",", "<C-g>", "u"] },
        { "before": [";"], "after": [";", "<C-g>", "u"] },
        { "before": ["!"], "after": ["!", "<C-g>", "u"] },
        { "before": ["?"], "after": ["?", "<C-g>", "u"] },
        { "before": ["<"], "after": ["<", "<C-g>", "u"] },
        { "before": [">"], "after": [">", "<C-g>", "u"] },
    ],

    // ==> Visual mode
    "vim.visualModeKeyBindings": [
        // Command mode without shift
        { "before": [";"], "after": [":"] },

        // Easy change upper/lower case
        { "before": ["`"], "after": ["~"] },

        // Indenting lines
        { "before": [">"], "commands": ["editor.action.indentLines"] },
        { "before": ["<"], "commands": ["editor.action.outdentLines"] },

        // Expand/shrink selection to parents
        { "before": ["shift+k"], "commands": ["editor.action.smartSelect.expand"] },
        { "before": ["shift+j"], "commands": ["editor.action.smartSelect.shrink"] },
    ],

